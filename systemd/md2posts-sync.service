[Unit]
Description=md2posts sync service (Markdown to Multi-Platform Posts)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/md2posts
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"
Environment="NODE_ENV=production"
Environment="PATH=/root/.local/bin:/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/usr/bin/flock -n /tmp/md2posts.lock /usr/bin/node /opt/md2posts/src/cli/dist/index.js sync -c /opt/md2posts/config.yaml
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
