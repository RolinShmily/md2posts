# /etc/md2posts/md2posts.env (权限建议: chmod 600 /etc/md2posts/md2posts.env)

# 微信公众平台凭据（必须配置）
WECHAT_APPID=wx_your_appid_here
WECHAT_SECRET=your_appsecret_here

# 可选：同步通知 Webhook 地址（支持飞书 / 企业微信 / 钉钉 / 通用 JSON）
# 若已在 config.yaml 的 notify.webhookUrl 中配置，此处可留空注释；若配置则优先覆盖
# MD2POSTS_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
