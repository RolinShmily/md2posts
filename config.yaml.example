# md2posts 配置文件模板 (config.yaml.example)

source:
  type: fs
  # 远程博客 Git 仓库地址（支持 HTTPS 或 SSH，留空则仅读取本地文章目录）
  repoUrl: "https://github.com/your-username/your-blog.git"
  # Git 远端名称（默认: origin）
  gitRemote: "origin"
  # Git 目标分支（默认: main）
  gitBranch: "main"
  # 是否自动从远程拉取最新提交（默认: true）
  gitPull: true
  # 自动拉取冷却周期（默认: 24h，一天内不重复拉取远程仓库，直接使用本地缓存）
  pullInterval: "24h"
  # 仓库内文章相对路径（默认: content/posts，Hugo 常用 content/posts，Hexo 常用 source/_posts）
  postsPath: "content/posts"
  # 本地仓库嵌套缓存路径（可选，留空则自动缓存在 .cache/blog-repo，已加入 .gitignore 不污染外层）
  repoRoot: ""
  # （可选）若直接使用本地已有文章目录，可填入本地相对路径或绝对路径：
  # postsRoot: "/path/to/blog/content/posts"
  # 文章目录组织形式：bundle (<slug>/index.md) 或 flat (posts/<slug>.md)
  layout: bundle
  # 静态资源查找根目录（按顺序匹配，{postDir} 代表当前文章目录，{repoRoot} 代表博客仓库根目录）
  assetRoots:
    - "{postDir}"
    - "{repoRoot}/public"

site:
  # 博客网站访问基础 URL（用于文末版权卡片与相对链接补全）
  url: "https://blog.example.com"
  # 文章 URL 路由规则（{slug} 将被替换为具体文章标识）
  postPath: "/posts/{slug}/"
  # 文章默认署名作者
  author: "YourName"
  # 版权声明协议
  license: "CC BY-NC-SA 4.0"

render:
  # 内置 28 套公众号排版主题 (运行 md2posts themes 可查看全部清单)
  # 推荐: tech-blue (科技蓝), fullstack-blue (全栈蓝), klein (克莱因蓝)
  theme: "tech-blue"
  # 主色调覆盖（留空则跟随主题默认主色，例如填: "#0e88eb"）
  accent: ""
  # 正文字号 (px)
  fontSize: 15
  # 字体方案: theme (跟随主题), sans (黑体), serif (宋体), rounded (圆体)
  fontFamily: "theme"
  # 是否开启 Mac 风格代码块窗口
  macCode: true
  # 图片画廊排版模式: stack (单列堆叠), grid (网格), collage (拼贴)
  galleryMode: "stack"
  # 是否将非微信域名的外部链接自动转换为文末带编号的【参考资料】脚注
  linksToFootnotes: true
  # 是否将正文 h1~h5 标题顺移为 h2~h6（防止章节标题与主题刊头居中大标题冲突）
  shiftBodyHeadings: true
  # 图片图注模式: smart (智能过滤无意义截图名称), all (保留所有图注), none (不生成图注)
  imageCaptionMode: "smart"
  # 是否在正文顶部额外插入一张封面大图
  insertHeaderCover: false
  # 是否在正文末尾追加原文链接与版权说明卡片
  appendCopyrightCard: true

sync:
  # 默认自动同步的目标平台: wechat (仅微信公众号，默认) | heybox (仅小黑盒) | all (双端同时推送)
  # 命令行参数具有更高优先级，如: pnpm cli sync --to all 或 pnpm cli push <slug> --to all
  target: "wechat"
  # 同步基线 / 状态文件（相对 config.yaml 所在目录解析）
  # 记录每篇文章的 contentHash、平台草稿 ID 与图片缓存，也就是"哪些文章已经推过"。
  # ⚠️ 该文件是【机器本地】的：新机器/VPS 上它为空时，所有文章都会被当作"新增"。
  #    为防止误推，空基线且存在待推文章时 sync 会中止，需先 `md2posts baseline`
  #    （或把原机器的 state.json 复制过来），确属首次推送则加 `--initial-push`。
  stateFile: "./state.json"
  # 单次同步推送的最大文章数量（防止首次或批量同步超出微信 API 调用上限）
  maxPerRun: 5
  # 定时 sync 时是否自动将已修改的老文章也重新推送到草稿箱（默认 false: sync 只推新文章，老文章修改后由人工通过 push 选择推送）
  syncUpdated: false
  # 唯一兜底封面：仅当文章 frontmatter 没有 image 时使用（支持 {repoRoot} 占位符）。
  # 留空则这些文章会因缺少封面而同步失败，不会再去猜正文首图。
  defaultCover: "{repoRoot}/public/og/og.png"
  # 是否自动下载 jsDelivr 等外链图片转传至微信（防防盗链过滤）
  downloadRemoteImages: true
  # 是否开启草稿评论功能 (0 关闭, 1 开启)
  openComment: 0
  # 是否仅粉丝可评论 (0 所有人, 1 仅粉丝)
  onlyFansCanComment: 0

wechat:
  # 凭据以本文件为准；WECHAT_APPID / WECHAT_SECRET 环境变量仅在留空时作为兜底
  # （留空则微信同步会因缺少凭据而中止，不会用占位值凑数）
  appId: ""
  appSecret: ""

heybox:
  # 小黑盒创作者会话凭据文件路径（可选，留空则自动读取系统的 ~/.config/xiaoheihe-cli/session.json 或 %LOCALAPPDATA%\xiaoheihe-cli\session.json）
  sessionFile: ""
  # 底层推流工具命令名或绝对路径（可选，默认自动探测 PATH 中的 xiaoheihe 或 xiaoheihe-cli）
  cliPath: "xiaoheihe"
  # 浏览器执行通道 (chrome 或 msedge，用于无头推流或本地扫码)
  browserChannel: "chrome"
  # 代码块渲染策略 (auto | terminal | image)
  #   auto     - 默认：短命令/配置片段(<=6行或 bash/pwsh/config 等)转原生终端块(可长按复制)，
  #              长程序源码(>6行) 转 2x Retina 深色代码卡片图
  #   terminal - 全部转原生终端块（零图片、100% 可复制，适合纯命令教程类文章）
  #   image    - 全部转高清代码卡片图（适合需要语法高亮的复杂长源码）
  codeBlockMode: "auto"

notify:
  # 可选：同步结果 Webhook 通知地址（支持飞书 / 企业微信 / 钉钉 / 通用 JSON）
  # 本文件优先；留空时回退到 MD2POSTS_WEBHOOK_URL 环境变量
  webhookUrl: ""
  onSuccess: true
  onFailure: true
